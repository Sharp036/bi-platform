# ══════════════════════════════════════════════
#  Datorio — Environment Variables
#  Copy this to .env and adjust values
# ══════════════════════════════════════════════

# Application
APP_PORT=8080

# PostgreSQL (metadata)
DB_PASSWORD=datorio_secret
PG_PORT=5433

# ClickHouse (sample data)
CH_PASSWORD=clickhouse
CH_HTTP_PORT=8123
CH_NATIVE_PORT=9000

# Security
JWT_SECRET=change_me_in_production_at_least_32_characters_long

# Default admin
ADMIN_USER=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@datorio.local

# Airflow REST API for the "Start a job" buttons (empty = buttons disabled)
AIRFLOW_API_URL=
AIRFLOW_API_USER=
AIRFLOW_API_PASSWORD=
AIRFLOW_ALLOWED_DAGS=

# Email delivery of reports
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@datorio.local
SMTP_USE_TLS=true

# Public address for embed links (empty = relative links)
EMBED_BASE_URL=

# Saved export files; mount a volume here to keep them across container recreation
EXPORT_DIRECTORY=/tmp/datorio-exports
